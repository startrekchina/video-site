# Local-only values read by cloudflare.config.ts and the cf CLI. Copy to `.env`; never commit it.
# Owner email is server-only; Cloudflare identifiers are needed for preview / production builds and remote cf commands.
# Workers Builds sets the PREVIEW_* values in Previews Base and the PRODUCTION_* values in Production.

# CLOUDFLARE_ACCOUNT_ID=
# LOCAL_OWNER_EMAIL=owner@example.test

# Preview
# PREVIEW_OWNER_EMAIL=owner@example.invalid
# PREVIEW_TURNSTILE_SITE_KEY=
# PREVIEW_D1_DATABASE_NAME=
# PREVIEW_D1_DATABASE_ID=
# PREVIEW_MEDIA_BUCKET_NAME=
# PREVIEW_EMAIL_API_BASE_URL=https://postal.example.invalid
# PREVIEW_EMAIL_SENDER_DOMAIN=example.invalid
# PREVIEW_EMAIL_FROM=preview@example.invalid
# PREVIEW_EMAIL_REPLY_TO=support@example.invalid

# Production
# PRODUCTION_OWNER_EMAIL=owner@example.invalid
# PRODUCTION_TURNSTILE_SITE_KEY=
# PRODUCTION_D1_DATABASE_NAME=
# PRODUCTION_D1_DATABASE_ID=
# PRODUCTION_MEDIA_BUCKET_NAME=
# PRODUCTION_EMAIL_API_BASE_URL=https://postal.example.invalid
# PRODUCTION_EMAIL_SENDER_DOMAIN=example.invalid
# PRODUCTION_EMAIL_FROM=noreply@example.invalid
# PRODUCTION_EMAIL_REPLY_TO=support@example.invalid
