# Local-only values read by cloudflare.config.ts and the cf CLI. Copy to `.env`; never commit it.
# Only needed for staging / production builds and remote cf commands.
# Both D1 IDs are required for either deployment mode and must refer to separate databases.

# CLOUDFLARE_ACCOUNT_ID=

# Staging
# STAGING_APP_ORIGIN=https://staging.example.invalid
# STAGING_TURNSTILE_SITE_KEY=
# STAGING_D1_DATABASE_NAME=
# STAGING_D1_DATABASE_ID=
# STAGING_MEDIA_BUCKET_NAME=
# STAGING_EMAIL_API_BASE_URL=https://postal.example.invalid
# STAGING_EMAIL_SENDER_DOMAIN=example.invalid
# STAGING_EMAIL_FROM=staging@example.invalid
# STAGING_EMAIL_REPLY_TO=support@example.invalid

# Production
# PRODUCTION_TURNSTILE_SITE_KEY=
# PRODUCTION_D1_DATABASE_NAME=
# PRODUCTION_D1_DATABASE_ID=
# PRODUCTION_MEDIA_BUCKET_NAME=
# PRODUCTION_EMAIL_API_BASE_URL=https://postal.example.invalid
# PRODUCTION_EMAIL_SENDER_DOMAIN=example.invalid
# PRODUCTION_EMAIL_FROM=noreply@example.invalid
# PRODUCTION_EMAIL_REPLY_TO=support@example.invalid
