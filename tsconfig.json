{
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*", ".cloudflare/types/**/*"],
  "exclude": ["node_modules", "build", "prototypes", "spikes", ".worktree", ".cloudflare/output", "assets-raw"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["node", "vite/client", "@cloudflare/vitest-plugin/types"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "@/*": ["./app/*"] },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  }
}
