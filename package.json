{
  "name": "video-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "react-router build --mode development",
    "build:staging": "react-router build --mode staging",
    "build:production": "react-router build --mode production",
    "deploy:staging": "pnpm build:staging && pnpm deploy:staging:prebuilt",
    "deploy:staging:prebuilt": "node scripts/prepare-staging-wrangler.mjs && wrangler deploy --config .cloudflare/wrangler-staging/wrangler.json",
    "deploy:production": "pnpm build:production && cf deploy --prebuilt --mode production",
    "typecheck": "cf workers types && react-router typegen --mode development && tsc",
    "db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000000 --local --persist-to .cloudflare/state",
    "test": "vitest run",
    "test:tools": "node --test scripts/*.test.mjs",
    "db:migrate:staging": "node scripts/migrate-remote.mjs staging",
    "db:migrate:production": "node scripts/migrate-remote.mjs production",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/passkey": "1.7.7",
    "@fontsource-variable/antonio": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@ncdai/react-swipe-actions": "0.3.0",
    "artplayer": "5.4.0",
    "artplayer-plugin-danmuku": "5.3.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "^5.2.2",
    "lucide-react": "1.49.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "simple-icons": "16.35.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@cloudflare/build-output-utils": "0.8.5",
    "@cloudflare/config": "0.23.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.12",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.12",
    "wrangler": "4.150.0"
  }
}
