# Local-only Worker secrets for `cf dev` and tests. Copy to `.dev.vars`; never commit real values.
# Production and staging secrets live in Worker Secrets, one independent set per environment.
BETTER_AUTH_SECRET=local-dev-better-auth-secret-0123456789abcdef
# Cloudflare's documented always-pass Turnstile test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
BACKUP_ENCRYPTION_KEY=local-dev-backup-encryption-key-0123456789abcdef
EMAIL_API_KEY=local-dev-email-api-key
# Backup export token: a separate runtime secret, never sent to the browser.
CLOUDFLARE_API_TOKEN=local-dev-cloudflare-api-token
# Optional external targets. Leave empty to disable; provision the WebDAV directory first.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
S3_BACKUP_ENDPOINT=
S3_BACKUP_REGION=
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
# Optional historical {"backupKey":"...","authSecret":"..."} entries; each secret is selected by its own fingerprint.
BACKUP_KEYRING=[]
